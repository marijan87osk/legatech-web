Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve signals from the previous WordPress URL structure. These rules
  # use the canonical host directly so legacy HTTP/www requests need one hop.
  RewriteRule ^naslovna/?$ https://legatech.hr/ [R=301,L,NE]
  RewriteRule ^o-meni/?$ https://legatech.hr/o-nama/ [R=301,L,NE]
  RewriteRule ^izrada-web-trgovine/?$ https://legatech.hr/izrada-web-trgovina/ [R=301,L,NE]
  RewriteRule ^izrada-web-stranica/?$ https://legatech.hr/izrada-web-stranica-cijena/ [R=301,L,NE]
  RewriteRule ^seo-optimizacija/?$ https://legatech.hr/seo-optimizacija-cijena/ [R=301,L,NE]
  RewriteRule ^robots-xml-sitemap/?$ - [R=410,L]

  # One public origin prevents www and HTTP copies from competing in search.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^legatech\.hr$ [NC]
  RewriteRule ^ https://legatech.hr%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]

  # Static routes are directories with an index.html file. Empty directories
  # left behind after a withdrawn article must return the custom 404, not 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML is revalidated after deploy, while fingerprinted Next.js assets can
  # remain cached for a year without serving stale code.
  Header always set Cache-Control "public, max-age=0, must-revalidate" "expr=%{REQUEST_URI} =~ m#(?:/|\.html)$#"
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/_next/static/#"
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
