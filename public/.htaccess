Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]

  # Static routes are directories with an index.html file. Empty directories
  # left behind after a withdrawn article must return the custom 404, not 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML changes on every static deploy. Do not let the CDN keep an old page
  # while hashed CSS, JavaScript, fonts and images remain cacheable.
  Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0" "expr=%{REQUEST_URI} =~ m#(?:/|\.html)$#"
  Header always set Pragma "no-cache" "expr=%{REQUEST_URI} =~ m#(?:/|\.html)$#"
  Header always set Expires "0" "expr=%{REQUEST_URI} =~ m#(?:/|\.html)$#"
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
