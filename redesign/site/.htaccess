Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve signals from the previous WordPress URL structure. These rules
  # use the canonical host directly so legacy HTTP/www requests need one hop.
  RewriteRule ^naslovna/?$ https://legatech.hr/ [R=301,L,NE]
  RewriteRule ^o-meni/?$ https://legatech.hr/o-nama/ [R=301,L,NE]
  RewriteRule ^izrada-web-trgovine/?$ https://legatech.hr/izrada-web-trgovina/ [R=301,L,NE]
  RewriteRule ^izrada-web-stranica/?$ https://legatech.hr/izrada-web-stranica-cijena/ [R=301,L,NE]
  RewriteRule ^seo-optimizacija/?$ https://legatech.hr/seo-optimizacija-cijena/ [R=301,L,NE]
  RewriteRule ^robots-xml-sitemap/?$ - [R=410,L]

  # One public origin prevents www and HTTP copies from competing in search.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^legatech\.hr$ [NC]
  RewriteRule ^ https://legatech.hr%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]

  # Static routes are directories with an index.html file. Empty directories
  # left behind after a withdrawn article must return the custom 404, not 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # HTML is revalidated after deploy, while fingerprinted Next.js assets can
  # remain cached for a year without serving stale code.
  Header always set Cache-Control "public, max-age=0, must-revalidate" "expr=%{REQUEST_URI} =~ m#(?:/|\.html)$#"
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/_next/static/#"
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Approved expressive release: no local runtime/config/test endpoints.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://www.googletagmanager.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'report-sample'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; worker-src 'none'; media-src 'none'"
  Header always set X-Frame-Options "DENY"
  Header unset X-Robots-Tag "expr=%{HTTP_HOST} =~ m#^(?:www\.)?legatech\.hr$#"
  Header always unset X-Robots-Tag "expr=%{HTTP_HOST} =~ m#^(?:www\.)?legatech\.hr$#"
  <FilesMatch "\.(?:css|js)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteRule ^(?:reviews|design-exploration|graft|private|server)(?:/|$) - [R=404,L]
  RewriteRule ^api/(?!contact\.php$) - [R=404,L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://legatech.hr/$1 [R=301,L,NE]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
